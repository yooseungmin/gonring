'use client';

import React, { useState, useEffect } from 'react';
import Link from 'next/link';
import { useRouter } from 'next/navigation';
import { Box, Search, Tag as TagIcon, ArrowRight, FileText, Brain, PlusCircle } from 'lucide-react';
import TagCloud from '@/components/tag/TagCloud';
import { searchApi, TagCloudItem } from '@/lib/searchApi';
import TaggingBoxLogo from '@/components/brand/TaggingBoxLogo';
import BrandButton from '@/components/brand/BrandButton';
import QuickActionCard from '@/components/home/QuickActionCard';
import FeatureCard from '@/components/home/FeatureCard';
import UseCaseExample from '@/components/home/UseCaseExample';
import SectionTitle from '@/components/home/SectionTitle';

export default function HomePage() {
  const router = useRouter();
  const [popularTags, setPopularTags] = useState<TagCloudItem[]>([]);
  const [recentBoxes, setRecentBoxes] = useState<any[]>([]);
  const [isLoading, setIsLoading] = useState(true);

  // Quick Actions 정의
  const quickActions = [
    {
      icon: "📝",
      title: "새 메모 작성",
      description: "아이디어를 적고 AI 태그 추천받기",
      action: "/contents/create/rich",
      color: "yellow"
    },
    {
      icon: "🔍", 
      title: "내 자료 검색",
      description: "태그와 키워드로 빠르게 찾기",
      action: "/search",
      color: "blue"
    },
    {
      icon: "🤖",
      title: "AI와 대화", 
      description: "내 지식 기반 개인 맞춤 답변",
      action: "/chat",
      color: "green"
    },
    {
      icon: "📦",
      title: "새 박스 만들기",
      description: "프로젝트별로 체계적 정리",
      action: "/boxes/create", 
      color: "purple"
    }
  ];

  // 사용 사례 예시
  const useCases = [
    {
      title: "📚 논문 연구자",
      example: "논문 요약 → AI 태그 추천 → 관련 자료 연결"
    },
    {
      title: "🎓 대학생", 
      example: "수업 노트 → 태그 정리 → 시험 전 빠른 검색"
    },
    {
      title: "💼 직장인",
      example: "업무 아이디어 → 프로젝트별 박스 → AI 보고서 작성"
    }
  ];

  // 주요 기능
  const features = [
    {
      icon: "🏷️",
      title: "AI 태그 추천",
      description: "내용을 분석하여 관련 태그를 자동으로 추천해줍니다."
    },
    {
      icon: "🔗",
      title: "지식 관계도 시각화",
      description: "콘텐츠 간의 연결 관계를 시각적으로 확인할 수 있습니다."
    },
    {
      icon: "🧠",
      title: "개인 맞춤 AI 검색",
      description: "내 지식을 기반으로 개인화된 검색 결과를 제공합니다."
    }
  ];

  // 인기 태그 로드
  useEffect(() => {
    const loadPopularTags = async () => {
      try {
        const response = await searchApi.getTagCloud(15); // 상위 15개 태그만 가져오기
        if (response.success) {
          setPopularTags(response.data.tags);
        }
      } catch (error) {
        console.error('태그 로딩 오류:', error);
      }
    };
    
    // 최근 박스 로드 (예시 데이터)
    const mockRecentBoxes = [
      { id: 'box1', name: '연구 프로젝트', contentCount: 15, updatedAt: new Date() },
      { id: 'box2', name: '학습 자료', contentCount: 8, updatedAt: new Date(Date.now() - 3600000) },
      { id: 'box3', name: '논문 모음', contentCount: 12, updatedAt: new Date(Date.now() - 86400000) },
    ];
    
    const loadData = async () => {
      setIsLoading(true);
      await loadPopularTags();
      setRecentBoxes(mockRecentBoxes); // 실제 API 연동 시 변경
      setIsLoading(false);
    };
    
    loadData();
  }, []);
  
  // 태그 클릭 처리
  const handleTagClick = (tagName: string) => {
    router.push(`/search?tags=${encodeURIComponent(tagName)}`);
  };

  return (
    <div className="container mx-auto px-4 py-8 max-w-7xl">
      {/* Hero 섹션 */}
      <section className="mb-12">
        <div className="mb-4">
          <div className="w-36">
            <TaggingBoxLogo type="normal" size="large" />
          </div>
        </div>
        <h1 className="text-3xl font-light text-notion-black mb-3">
          당신의 지식을 체계적으로 <span className="bg-tb-yellow bg-opacity-30 px-1">관리하고 공유</span>하는 플랫폼
        </h1>
        <p className="text-lg text-notion-gray-700 mb-8">
          태그 기반으로 메모를 정리하고 연결하여 개인 지식 관리 시스템을 구축하세요
        </p>
      </section>

      {/* Quick Actions 섹션 */}
      <section className="mb-12">
        <SectionTitle
          title="바로 시작하기"
          className="mb-5"
        />
        <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
          {quickActions.map((action, index) => (
            <QuickActionCard
              key={index}
              icon={action.icon}
              title={action.title}
              description={action.description}
              action={action.action}
              color={action.color as 'yellow' | 'blue' | 'green' | 'purple'}
            />
          ))}
        </div>
      </section>
      
      {/* 주요 기능 섹션 */}
      <section className="mb-12">
        <SectionTitle
          title="이런 것들을 할 수 있어요"
          className="mb-5"
        />
        <div className="grid grid-cols-1 md:grid-cols-3 gap-6">
          {features.map((feature, index) => (
            <FeatureCard
              key={index}
              icon={feature.icon}
              title={feature.title}
              description={feature.description}
            />
          ))}
        </div>
      </section>
      
      {/* 사용 사례 섹션 */}
      <section className="mb-12">
        <SectionTitle
          title="이렇게 활용하세요"
          className="mb-5"
        />
        <div className="grid grid-cols-1 md:grid-cols-3 gap-4">
          {useCases.map((useCase, index) => (
            <UseCaseExample
              key={index}
              title={useCase.title}
              example={useCase.example}
            />
          ))}
        </div>
      </section>
      
      {/* 인기 태그 섹션 */}
      <section className="mb-12">
        <SectionTitle
          title="인기 태그"
          viewAllLink="/search"
          viewAllText="모든 태그 보기"
        />
        
        {isLoading ? (
          <div className="h-32 flex items-center justify-center bg-notion-gray-50 rounded-md">
            <div className="animate-spin rounded-full h-8 w-8 border-b-2 border-notion-blue"></div>
          </div>
        ) : (
          <div className="bg-white p-6 rounded-md border border-notion-gray-200 shadow-sm">
            {popularTags.length > 0 ? (
              <TagCloud tags={popularTags} onTagClick={handleTagClick} />
            ) : (
              <p className="text-notion-gray-700 text-center py-4">아직 태그가 없습니다.</p>
            )}
          </div>
        )}
      </section>
      
      {/* 최근 박스 섹션 */}
      <section>
        <SectionTitle
          title="최근 박스"
          viewAllLink="/boxes"
          viewAllText="모든 박스 보기"
        />
        
        {isLoading ? (
          <div className="h-32 flex items-center justify-center bg-notion-gray-50 rounded-md">
            <div className="animate-spin rounded-full h-8 w-8 border-b-2 border-notion-blue"></div>
          </div>
        ) : (
          <div className="grid grid-cols-1 md:grid-cols-3 gap-4">
            {recentBoxes.map(box => (
              <Link 
                key={box.id} 
                href={`/boxes/${box.id}`}
                className="bg-white p-5 rounded-md border border-notion-gray-200 shadow-sm hover:border-notion-gray-300 hover:shadow-md transition-all duration-normal"
              >
                <h3 className="text-lg font-normal text-notion-black mb-2">{box.name}</h3>
                <div className="flex items-center text-sm text-notion-gray-700">
                  <span className="mr-3">{box.contentCount} 콘텐츠</span>
                  <span>{new Date(box.updatedAt).toLocaleDateString()}</span>
                </div>
              </Link>
            ))}
          </div>
        )}
      </section>
    </div>
  );
}
